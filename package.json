{
  "name": "matrix-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Thin proxy for Matrix: Yahoo Finance quotes/history/news + Ask Matrix (Groq/OpenRouter/Gemini/Anthropic) + phone-PIN login, with caching and CORS.",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test $(ls test/*.cjs | grep -Ev '\\.sandbox\\.cjs$')"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.1",
    "pg": "^8.22.0",
    "undici": "^6.27.0"
  }
}
